    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="MensagensErros\CodigoErro.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>CodigoErro.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="MensagensErros\MensagemErro.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>MensagemErro.Designer.cs</LastGenOutput>
    </EmbeddedResource>
